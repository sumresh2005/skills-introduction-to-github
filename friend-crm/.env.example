PORT=3000

# Optional default Facebook birthdays feed. You can also paste this in the
# UI each time instead. Find yours at: facebook.com -> Events -> Birthdays
# -> Export -> copy the "Upcoming birthdays" webcal:// link.
FACEBOOK_BIRTHDAYS_ICS_URL=

# Google OAuth (People API), for importing your own Google Contacts.
# 1. Create a project at https://console.cloud.google.com and enable "People API"
# 2. Configure the OAuth consent screen (add yourself as a test user if External)
# 3. Credentials -> Create OAuth client ID -> Web application
# 4. Add this authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
